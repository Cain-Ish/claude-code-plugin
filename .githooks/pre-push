#!/usr/bin/env bash
# pre-push: run the full second-brain test suite before allowing a push.
# Wired in via `git config core.hooksPath .githooks` (or `make hook-install`).
#
# Bypass (debugging only — and please don't make a habit of it):
#   SB_SKIP_PREPUSH=1 git push
#   git push --no-verify
#
# The bypass envs exist so you can recover from a genuinely broken test that
# blocks an urgent fix. Always follow up with a real fix afterward; otherwise
# the next push regresses again.
#
# Opt-in production-config lane (D017 / post-audit improvement 4B):
#   SB_PREPUSH_PRODUCTION_LANE=1 git push
# also runs `make production-lane` — the search/episodic vitest files plus
# test-injection-gate.sh/test-loop-smoke.sh with embeddings ACTUALLY ENABLED
# (SECOND_BRAIN_DISABLE_EMBEDDINGS=0), the only place the real hybrid BM25+RRF
# path is exercised. OFF by default: CI has no network to fetch the model, and
# most developer machines won't have it cached either, so this stays a manual,
# opt-in developer-machine gate — never a CI dependency and never run by
# `make test`/`tests/run-all.sh`. Needs the model pre-installed via
# bin/install-vector-deps.sh; adds ~1-2 minutes.
set -u

if [ "${SB_SKIP_PREPUSH:-0}" = "1" ]; then
  echo "pre-push: SB_SKIP_PREPUSH=1 — skipping test gate (please fix tests soon)"
  exit 0
fi

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
RUNNER="$ROOT/tests/run-all.sh"
[ -x "$RUNNER" ] || { echo "pre-push: $RUNNER not executable; aborting"; exit 1; }

echo "pre-push: running $RUNNER"
echo "pre-push: this is the verification gate that decides whether v$(jq -r .version "$ROOT/.claude-plugin/plugin.json" 2>/dev/null || echo "?") can ship."
echo
"$RUNNER" || {
  rc=$?
  echo
  echo "pre-push: BLOCKED — at least one test failed. Fix it or run with SB_SKIP_PREPUSH=1 if you understand why."
  echo "pre-push: bypassing the gate without a fix is how 'production' versions ship broken."
  exit $rc
}

echo "pre-push: all tests green."

if [ "${SB_PREPUSH_PRODUCTION_LANE:-0}" = "1" ]; then
  echo
  echo "pre-push: SB_PREPUSH_PRODUCTION_LANE=1 — running \`make production-lane\` (embeddings ON; developer-machine only)."
  ( cd "$ROOT" && make production-lane ) || {
    rc=$?
    echo
    echo "pre-push: BLOCKED — production-lane failed (embeddings-ON hybrid path). Fix it, or push without SB_PREPUSH_PRODUCTION_LANE=1 if the model isn't installed here."
    exit $rc
  }
  echo "pre-push: production-lane green too."
fi

echo "pre-push: push allowed."
exit 0
