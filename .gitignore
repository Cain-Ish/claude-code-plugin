# User knowledge — NEVER committed
knowledge/

# Plugin learning state — local only (legacy + current names)
.claude-companion/
.second-brain/

# Plugin data directory (managed by Claude Code)
.claude-plugin-data/

# Local-only Claude Code session settings (per-user permission grants etc.)
.claude/settings.local.json

# MCP server build artifacts.
# mcp/dist/ IS tracked so marketplace installs work without npm — without
# this, knowledge_search/index/stats fail until the user runs setup. The
# setup skill rebuilds dist/ from src/ if needed (e.g., after dependency bumps).
mcp/node_modules/

# OS files
.DS_Store
Thumbs.db

# Node
node_modules/

# IDE
.idea/
.vscode/
*.swp
*.swo
