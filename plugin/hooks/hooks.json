{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|clear|resume|compact|fork",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "command -v node >/dev/null 2>&1 && exec node \"${CLAUDE_PLUGIN_ROOT}/scripts/hook.mjs\" session-start || echo '{\"systemMessage\":\"The project map needs Node 20 or later; install it, or disable the plugin.\"}'",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [{ "type": "command", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/hook.mjs", "prompt"], "timeout": 10 }]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Read",
        "hooks": [{ "type": "command", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/hook.mjs", "read"], "timeout": 10 }]
      },
      {
        "matcher": "Bash",
        "hooks": [{ "type": "command", "if": "Bash(*.project-map*)", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/hook.mjs", "bash"], "timeout": 10 }]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Bash",
        "hooks": [{ "type": "command", "if": "Bash(*.project-map*)", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/hook.mjs", "bash-failure"], "timeout": 10 }]
      }
    ]
  }
}
